# Plantilla de configuración de la base de datos.
# Copiar este archivo como "db.properties" y completar los datos.
# db.properties NO se sube al repositorio (está en .gitignore).
# Las variables de entorno DB_URL, DB_USER y DB_PASSWORD tienen prioridad sobre este archivo.

db.url=jdbc:mysql://localhost:3306/tpi-bd-i
db.user=root
db.password=